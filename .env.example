# 環境ごとの値（ローカルと本番、Mac を替えたときで変わる）
# 切り替えは NEWS_ENV だけ。中身は LLM_BASE_URL / LLM_MODEL / LLM_CONCURRENCY の既定値
NEWS_ENV=local
NEWS_DB_PATH=data/news.db
NEWS_DIST_DIR=dist
NEWS_USER_AGENT=world-events/0.1 (+personal use)

# --- 要約 LLM（OpenAI 互換） ---
# ローカル（開発）: Mac の Ollama。qwen3.5:9b（4bit 約 6GB）。同時に投げる数は 1〜2
#   LLM_BASE_URL=http://host.docker.internal:11434/v1
#   LLM_MODEL=qwen3.5:9b
# 本番: Worker `summarizer` → Workers AI。論理名 summarizer を Worker 側で実モデルに変換する。同時に 8〜16
#   LLM_BASE_URL=https://summarizer.<subdomain>.workers.dev/v1
#   LLM_MODEL=summarizer
# 省略すると NEWS_ENV の既定値になる
LLM_BASE_URL=
LLM_MODEL=
LLM_CONCURRENCY=
LLM_API_KEY=local
# Qwen3 系の thinking を切る指定など、サーバーに渡す追加項目（JSON）。出力トークン（費用と時間）が何倍にも増えるのを防ぐ。
# サーバーによって書き方が違うので、bench で効いているか確かめる。例: {"chat_template_kwargs": {"enable_thinking": false}}
LLM_EXTRA_BODY=
# 1 晩のトークン数の上限。0 なら「前日の 2 倍（下限 50 万）」だけを使う
LLM_DAILY_TOKEN_LIMIT=0

# --- 埋め込み（ローカル・本番とも CPU の bge-m3。環境で実装を変えない） ---
EMBED_MODEL=BAAI/bge-m3

# --- 秘密の値（git に入れない。実物は .env に書く） ---
# 本番: summarizer 用の Cloudflare Access サービストークン
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
ANTHROPIC_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
NTFY_TOPIC=
