{
  "name": "world-events-viewer",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "node scripts/gen-contracts.mjs",
    "dev": "npm run gen && wrangler dev",
    "deploy": "npm run gen && wrangler deploy",
    "migrate": "wrangler d1 migrations apply world-events --remote",
    "migrate:local": "wrangler d1 migrations apply world-events --local",
    "seed:local": "wrangler d1 execute world-events --local --file ../../dist/d1_upsert.sql",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
